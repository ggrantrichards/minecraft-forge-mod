{
  "multipart": [
    {
      "apply": {
        "model": "astralend:block/collector_pedestal"
      }
    },
    {
      "when": {
        "holding": "void_crystal"
      },
      "apply": {
        "model": "astralend:block/collector_pedestal_void_crystal"
      }
    },
    {
      "when": {
        "holding": "charged_void_crystal"
      },
      "apply": {
        "model": "astralend:block/collector_pedestal_charged_void_crystal"
      }
    },
    {
      "when": {
        "holding": "glass_bottle"
      },
      "apply": {
        "model": "astralend:block/collector_pedestal_glass_bottle"
      }
    },
    {
      "when": {
        "holding": "bottled_flare"
      },
      "apply": {
        "model": "astralend:block/collector_pedestal_bottled_flare"
      }
    }
  ]
}
